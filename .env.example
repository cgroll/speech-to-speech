# Auth is via Google Application Default Credentials, not an API key here --
# pi-agent-gemini's org policy blocks plain Gemini-Developer-API keys.
# Run once: gcloud auth application-default login
#
# These two are optional overrides (defaults are already pi-agent-gemini /
# us-central1 in config.py):
# GEMINI_PROJECT=pi-agent-gemini
# GEMINI_LOCATION=us-central1

# Telegram bot (docs/telegram-bot-proposal.md). Create a new bot via
# @BotFather (recommended: don't reuse the existing reminder-bot token, see
# the proposal doc) and note its token, then find your own chat id (e.g. by
# messaging the new bot once and checking
# https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot; every other chat is
# silently ignored.
TELEGRAM_ALLOWED_CHAT_IDS=
