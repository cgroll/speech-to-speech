# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Node (only used locally for the graft CLI devDependency)
/node_modules/

# mkdocs build output (generated by `mkdocs build`/CI, not committed)
/site/

# Cockpit-uploaded chat attachments (clipboard/upload images copied into the
# workspace by App.submit_multimodal) — session-local, not source.
/.chat-attachments/
